# The core's settings at Latere; every PONS_* variable is in the core's
# configuration table (pons specs/011-distribution.md). The database URLs,
# the sealing keys, the GitHub App's client secret and the authorizer's
# bearer are Secrets, each named in deployment.yaml; none of them is here.
#
# The origin serves the core under /v1/connections, and so does
# connect.latere.ai, a host of the core's own; the core serves its API under
# that base path in the place of its own /v1, so neither Ingress rewrites.
# Every address the core hands out is PONS_PUBLIC_URL joined with the base
# path: the callback the GitHub App names,
# https://connect.latere.ai/v1/connections/callback, and a connection's
# addresses, https://connect.latere.ai/v1/connections/connections/{id}/http
# and /git. They are not on api.latere.ai because a sandbox reaches its
# models there with a Secret scoped to that host, and the sandbox core mounts
# no two Secrets on one host: the session's token for the connections must
# be scoped to a host of their own.
PONS_PUBLIC_URL=https://connect.latere.ai
PONS_BASE_PATH=/v1/connections
PONS_OIDC_ISSUERS=https://auth.latere.ai
# Every request is decided by platformd's Pons decider on its internal TLS
# listener; the bearer is the file the Secret ponsd-authorizer is mounted
# as.
PONS_AUTHORIZER_URL=https://platformd-internal.latere.svc.cluster.local/internal/pons/authorize
PONS_AUTHORIZER_TOKEN_FILE=/var/run/ponsd-authorizer/token
PONS_CATALOG_FILE=/etc/pons/catalog.yaml
# Where a person's browser returns after signing in at the other service:
# the chat's Connectors page and the console's Connections section, each
# exact.
PONS_RETURN_URLS=https://chat.latere.ai/settings/connectors,https://platform.latere.ai/console/connections
# The name a person reads on the other service's consent page.
PONS_CLIENT_NAME=Latere
